{
	"name": "gruvbox",
	"displayName": "Gruvbox Theme (Personal)",
	"description": "Gruvbox Theme. Personal fork.",
	"version": "1.0.0",
	"author": "bmarcurella (https://github.com/bmarcurella)",
	"publisher": "bmarcurella",
	"engines": {
		"vscode": "^1.67.2"
	},
	"categories": [
		"Themes"
	],
	"icon": "images/icon.png",
	"galleryBanner": {
		"color": "#3c3836",
		"theme": "dark"
	},
	"homepage": "https://github.com/bmarcurella/vscode-theme-gruvbox",
	"repository": {
		"type": "git",
		"url": "https://github.com/bmarcurella/vscode-theme-gruvbox.git"
	},
	"contributes": {
		"themes": [
			{
				"label": "Gruvbox Dark Medium",
				"uiTheme": "vs-dark",
				"path": "./themes/gruvbox-dark-medium.json"
			},
			{
				"label": "Gruvbox Dark Hard",
				"uiTheme": "vs-dark",
				"path": "./themes/gruvbox-dark-hard.json"
			},
			{
				"label": "Gruvbox Dark Soft",
				"uiTheme": "vs-dark",
				"path": "./themes/gruvbox-dark-soft.json"
			},
			{
				"label": "Gruvbox Light Medium",
				"uiTheme": "vs",
				"path": "./themes/gruvbox-light-medium.json"
			},
			{
				"label": "Gruvbox Light Hard",
				"uiTheme": "vs",
				"path": "./themes/gruvbox-light-hard.json"
			},
			{
				"label": "Gruvbox Light Soft",
				"uiTheme": "vs",
				"path": "./themes/gruvbox-light-soft.json"
			}
		]
	},
	"devDependencies": {
		"@eslint/js": "^9.21.0",
		"@types/node": "^22.13.7",
		"@vscode/vsce": "^3.2.2",
		"eslint": "^9.21.0",
		"eslint-config-prettier": "^10.0.2",
		"prettier": "3.5.2",
		"tsx": "^4.19.3",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.25.0"
	},
	"private": true,
	"scripts": {
		"dev": "tsx watch ./src/main.ts",
		"build": "tsx ./src/main.ts",
		"package": "npm run build && vsce package",
		"type:check": "tsc ./src/*.ts --noEmit",
		"lint:check": "eslint ./src",
		"format:check": "prettier ./src --check"
	},
	"license": "MIT",
	"type": "module"
}
